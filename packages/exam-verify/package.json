    "test": "tsc && node --test \"dist/__tests__/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mikeargento/bitgraph-audit": "^0.5.0",
    "@mikeargento/bitgraph-player": "^0.14.0",
    "@mikeargento/bitgraph-verify": "^1.11.0",
    "@mikeargento/exam-bank": "^0.1.0",
    "@mikeargento/exam-core": "^0.1.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mikeargento/sealed-exam.git",
    "directory": "packages/exam-verify"
  },
