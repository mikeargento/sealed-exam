{
  "name": "@mikeargento/exam-verify",
  "version": "0.1.1",
  "description": "Offline verification and grading of a sealed exam folder; extends bitgraph-verify, never forks it.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
